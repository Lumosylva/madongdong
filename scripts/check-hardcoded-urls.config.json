{
  "scan": {
    "include": ["app", "web/src", "admin/src"],
    "exclude": ["node_modules", "dist", ".git", ".venv", "__pycache__"],
    "extensions": [".ts", ".tsx", ".js", ".jsx", ".vue", ".py", ".json", ".md", ".yml", ".yaml", ".env", ".example", ".ini", ".conf", ".txt"]
  },
  "patterns": {
    "allow": [
      "http://127.0.0.1:8000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174"
    ],
    "deny": [
      {
        "name": "http://",
        "pattern": "http://"
      },
      {
        "name": "ws://",
        "pattern": "ws://"
      },
      {
        "name": "localhost:",
        "pattern": "localhost:\\d+"
      },
      {
        "name": "127.0.0.1:",
        "pattern": "127\\.0\\.0\\.1:\\d+"
      },
      {
        "name": "absolute domain",
        "pattern": "(?:https?:\\/\\/)?(?:[a-z0-9-]+\\.)+[a-z]{2,}(?::\\d+)?(?:\\/[^\\s\"'`)]*)?"
      }
    ]
  }
}
