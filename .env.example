# MaDongDong Blog 后端环境变量
# 复制此文件为 .env 并填入实际值

# JWT 签名密钥（必填，生产环境务必设置）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 数据库连接（默认使用 SQLite）
# DATABASE_URL=sqlite+aiosqlite:///./madongdong.db

# 调试模式（生产环境务必关闭）
# DEBUG=false

# SQL 查询日志（开发时可开启，生产环境务必关闭）
# SQL_ECHO=false

# Cookie 安全标志（生产环境启用 HTTPS 后设为 true）
# COOKIE_SECURE=false

# 信任代理头（反向代理后设为 true，否则 X-Forwarded-For 不被信任）
# TRUSTED_PROXY=false

# 文件上传目录
# UPLOAD_DIR=app/static/uploads

# 文件上传大小限制（字节，默认 10MB）
# UPLOAD_MAX_SIZE=10485760

# CORS 允许的来源（JSON 数组格式）
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
